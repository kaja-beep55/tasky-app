# ─────────────────────────────────────────────────────────────
# Tasky Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file. NEVER expose secrets to the frontend.
# ─────────────────────────────────────────────────────────────

# ── Backend-only secrets (serverless functions / API) ─────────
# HMAC secret used to sign user + admin session tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-32-byte-random-hex

# 10-digit code that unlocks the Admin Panel (server-side verified).
ADMIN_PANEL_CODE=0000000000

# Pepper for hashing account recovery codes (defense in depth on top of scrypt).
# Generate with: openssl rand -hex 32
RECOVERY_CODE_PEPPER=change-me-32-byte-random-hex

# ── Supabase (required only when connecting the real database) ─
# Public client configuration (safe for frontend, respects RLS):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend-only secret key (BYPASSES RLS — never ship to the frontend):
SUPABASE_SECRET_KEY=sb_secret_...

# ── Public frontend configuration ─────────────────────────────
# Admin WhatsApp number in international format, digits only (no +).
# Used to build https://wa.me/<number> links. Public by nature.
VITE_WHATSAPP_NUMBER=

# ── Local development only ────────────────────────────────────
# Where the local JSON-file database driver stores its data.
TASKY_LOCAL_DB_PATH=.tasky-local/db.json
